# Telegram Bot
BOT_TOKEN=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=report3
DB_USER=postgres
DB_PASS=

# API Keys
FNS_API_KEY=
IONET_API_KEY=
IONET_API_URL=https://api.intelligence.io.solutions/api/v1
IONET_MODEL=meta-llama/Llama-3.3-70B-Instruct

# App
DEBUG=False

# Rate limiting — защита платных API (ФНС, IO_NET) от спама/злоупотреблений
RATE_LIMIT_COOLDOWN_SECONDS=15
RATE_LIMIT_DAILY_MAX=20

# Логирование: LOG_FORMAT=text — читаемо для разработки, json — для прод/агрегаторов логов
LOG_LEVEL=INFO
LOG_FORMAT=text

# Дашборд (внутренняя админ-панель, доступ только через SSH-туннель)
DASHBOARD_SECRET_KEY=change-me-in-env
DASHBOARD_PORT=8080
DASHBOARD_BASE_URL=http://localhost:8080
