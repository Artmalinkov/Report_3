# Telegram
BOT_TOKEN=Ваш_токен_телеграмм-бота

# DataBase
DB_HOST=localhost
DB_PORT=5432
DB_NAME=report3
DB_USER=postgres
DB_PASS=ваш_пароль

# API-ФНС (api-fns.ru)
FNS_API_KEY=ваш_api

# API-IO-NET (io.net)
IONET_API_KEY=ваш_api
# Необязательные — есть рабочие значения по умолчанию в app/config.py
# IONET_API_URL=https://api.intelligence.io.solutions/api/v1
# IONET_MODEL=meta-llama/Llama-3.3-70B-Instruct

# App Settings
# DEBUG=True — использовать мок-данные вместо реального API ФНС (для разработки)
DEBUG=False

# Rate limiting — необязательные, есть значения по умолчанию в app/config.py
# RATE_LIMIT_COOLDOWN_SECONDS=15
# RATE_LIMIT_DAILY_MAX=20

# Логирование — необязательные, есть значения по умолчанию в app/config.py
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# На проде рекомендуется:
# LOG_FORMAT=json
